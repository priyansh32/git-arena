# GitArena local runtime (single env surface)
# Keep this file minimal. Most runtime defaults are in code/scripts.

# Required for Google login
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Local ports
API_PORT=3001
WEB_PORT=5173

# Local DB
DATABASE_URL=postgres://gitarena:gitarena@localhost:5432/gitarena

# Optional (defaults apply if unset)
# Leave empty to auto-allow http://localhost:${WEB_PORT}
CORS_ORIGINS=
SESSION_COOKIE_NAME=gitarena_session
SESSION_TTL_HOURS=168
# Test-only login gate (optional):
# AUTH_TEST_MODE=true
# AUTH_TEST_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional k8s-host-dev settings (only when using ./scripts/dev-up.sh ... k8s)
K8S_USE_CLOUDSQL=true
CLOUDSQL_ENV_FILE=.dev-runtime/cloudsql.env
GCP_PROJECT_ID=

# Optional workspace image override
WORKSPACE_IMAGE=
