# GitArena local runtime (single env surface)
# Keep this file minimal. Most runtime defaults are in code/scripts.

# Required for Google login
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Database password (used by postgres + api in docker compose)
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing secret — must be at least 32 chars
# Generate: openssl rand -hex 32
SESSION_SECRET=

# CORS origin(s) for the API (comma-separated)
CORS_ORIGINS=

# Test stack ports (docker compose up --build)
TEST_API_PORT=3001
TEST_WEB_PORT=5173

# Host-dev ports (./scripts/dev-up.sh ...)
DEV_API_PORT=3002
DEV_WEB_PORT=5174

# Local DB
DATABASE_URL=postgres://gitarena:gitarena@localhost:5432/gitarena

# Optional (defaults apply if unset)
SESSION_COOKIE_NAME=gitarena_session
SESSION_TTL_HOURS=168
# Test-only login gate (optional):
# AUTH_TEST_MODE=true
# AUTH_TEST_ALLOWED_EMAILS=you@example.com,teammate@example.com
# Optional host allowlist for Vite dev/preview (comma-separated tunnel domains)
VITE_ALLOWED_HOSTS=

# Optional Vite API proxy overrides (defaults: localhost:3001)
# VITE_API_PROXY_HOST=localhost
# VITE_API_PROXY_TARGET=http://localhost:3001

# Optional project hint for non-dev helper flows
GCP_PROJECT_ID=

# Optional: target a separate sessions cluster context (for safe Autopilot migration)
# WORKSPACE_K8S_CONTEXT=gke_your-project_us-central1-a_sandbox-cluster
# WORKSPACE_K8S_KUBECONFIG=/path/to/kubeconfig
# WORKSPACE_K8S_NODE_POOL=sandbox-pool
