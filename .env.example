HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://gitarena:gitarena@localhost:5432/gitarena
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_COOKIE_NAME=gitarena_session
SESSION_TTL_HOURS=168
WORKSPACE_PROVIDER=docker
WORKSPACE_IMAGE=gitarena-base:2.43.7-alpine3.19-v1
WORKSPACE_ROOT=/workspace
WORKSPACE_SHELL=/bin/bash
WORKSPACE_CONTAINER_PREFIX=gitarena-ws
WORKSPACE_INIT_COMMAND=mkdir -p /workspace && cd /workspace && exec tail -f /dev/null
WORKSPACE_K8S_NAMESPACE=gitarena-sessions
WORKSPACE_K8S_RUNTIME_CLASS_NAME=gvisor
WORKSPACE_K8S_IMAGE_PULL_POLICY=IfNotPresent
WORKSPACE_K8S_POD_READY_TIMEOUT_SECONDS=240
GCP_PROJECT_ID=
WORKSPACE_AR_LOCATION=us-central1
WORKSPACE_AR_REPOSITORY=gitarena
WORKSPACE_IMAGE_TAG=2.43.7-alpine3.19-v1
