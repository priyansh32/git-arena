GCP_API_GSA_EMAIL=gitarena-api-sa@your-project-id.iam.gserviceaccount.com
NODE_ENV=production
# URL-encoded DB password (not raw). Example encoder:
# node -e "console.log(encodeURIComponent('your-raw-password'))"
DB_PASSWORD_URLENC=REPLACE_WITH_URL_ENCODED_DB_PASSWORD
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
CORS_ORIGINS=https://your-web-domain.example
WORKSPACE_IMAGE=us-central1-docker.pkg.dev/your-project-id/gitarena/gitarena-base:<tag>
API_IMAGE=us-central1-docker.pkg.dev/your-project-id/gitarena/gitarena-api:<tag>
INSTANCE_CONNECTION_NAME=your-project-id:us-central1:your-cloudsql-instance

API_DOMAIN=api.your-domain.example
API_GLOBAL_STATIC_IP_NAME=gitarena-api-ip
API_PRE_SHARED_CERT_NAME=gitarena-api-cert-global
