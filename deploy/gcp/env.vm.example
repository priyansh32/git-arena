# Required runtime settings
INSTANCE_CONNECTION_NAME=your-project:your-region:your-cloudsql-instance
DATABASE_URL=postgres://gitarena:replace-me@cloudsql-proxy:5432/gitarena
CORS_ORIGINS=http://localhost,https://your-domain.example
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
SESSION_COOKIE_NAME=gitarena_session
SESSION_TTL_HOURS=168
VITE_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Optional overrides
WORKSPACE_IMAGE=alpine/git:2.47.2
WORKSPACE_ROOT=/workspace
WORKSPACE_SHELL=/bin/sh
WORKSPACE_CONTAINER_PREFIX=gitarena-ws
WORKSPACE_INIT_COMMAND=mkdir -p /workspace && cd /workspace && exec tail -f /dev/null
